{
  "opencollection": "1.0.0",
  "info": {
    "name": "Scanner Ad Hoc Queries Info API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Info",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get query capacity",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{environment}.scanner.dev/v1/info/query_capacity",
            "params": [
              {
                "name": "tenant_id",
                "value": "",
                "type": "query",
                "description": "Unique identifier for the tenant."
              }
            ]
          },
          "docs": "Retrieve query capacity metrics and configuration for a tenant."
        }
      ]
    }
  ],
  "bundled": true
}